{
  "name": "spin-wheel",
  "version": "1.0.0",
  "description": "Spin Wheel",
  "main": "main.js",
  "author": "Spin Wheel",
  "scripts": { "start": "electron ." },
  "build": {
    "appId": "com.spinwheel.pc",
    "productName": "Spin Wheel",
    "files": ["main.js", "index.html", "icon.png"],
    "win": { "target": "nsis", "icon": "icon.png" },
    "nsis": { "oneClick": true, "perMachine": false },
    "publish": [{ "provider": "github", "releaseType": "release" }]
  },
  "dependencies": { "electron-updater": "^6.3.0" },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.0" }
}
